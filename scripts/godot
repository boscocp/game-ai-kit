#!/usr/bin/env bash
# The only way this repo invokes Godot.
#
# Keeping the whole toolchain off the small disk needs TWO mechanisms, not one,
# and that is why nobody should call the binary directly:
#
#   1. `._sc_` next to the binary (self-contained mode) redirects editor data,
#      settings and export templates -- the part that grows past 1 GB.
#   2. XDG_DATA_HOME redirects the project's `user://` directory, which
#      self-contained mode does NOT cover. Measured on 4.7.2: without it,
#      `--import` alone recreates ~/.local/share/godot/app_userdata/.
#
# On Windows (Git Bash) the second mechanism is APPDATA, with LOCALAPPDATA for
# the cache: OS_Windows reads those two and not XDG_*. The binary called is the
# `_console` one, the only build whose output and exit code reach a terminal.
# docs/howto/windows.md.
#
# The redirect points inside this checkout, at `.user-data/` (ignored by git),
# so each worktree has its own `user://` (T83, docs/adr/0022). Under the
# toolchain it was one directory for every checkout, and two waves testing at
# once wrote each other's files. The checkout is on the large disk already:
# check_disk_layout.py's D5 holds that.
#
# `scripts/godot --gak-print-redirect` prints the redirect, one NAME=PATH a
# line, and exits without starting Godot: bootstrap, export.py and the gate
# read the decision from here instead of copying it.
#
# check_disk_layout.py fails if either mechanism stops working.
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

if [[ "${OS:-}" == "Windows_NT" ]]; then
  toolchain=${GAK_TOOLCHAIN:-D:/games/gamedev/toolchain}
  binary="$toolchain/godot/godot_console.exe"
  # `pwd -W` is Git Bash's D:/... form: godot.exe is a Windows program and
  # reads APPDATA as a Windows path, not as /d/....
  user_data="$(cd -- "$here" && pwd -W)/.user-data"
  redirect=(APPDATA="$user_data/appdata" LOCALAPPDATA="$user_data/localappdata")
else
  toolchain=${GAK_TOOLCHAIN:-/mnt/games/gamedev/toolchain}
  binary="$toolchain/godot/godot"
  user_data="$here/.user-data"
  redirect=(XDG_DATA_HOME="$user_data/xdg")
fi

if [[ "${1:-}" == "--gak-print-redirect" ]]; then
  printf '%s\n' "${redirect[@]}"
  exit 0
fi

if [[ ! -x "$binary" ]]; then
  echo "scripts/godot: toolchain missing at $binary -- run 'make bootstrap'" >&2
  exit 2
fi

want=$(tr -d '[:space:]' < "$here/.godot-version")
have=$("$binary" --headless --version 2>/dev/null | tr -d '\r' | head -1)
if [[ "$have" != "${want%-stable}.stable"* ]]; then
  echo "scripts/godot: pinned $want but toolchain reports $have" >&2
  exit 2
fi

exec env "${redirect[@]}" "$binary" "$@"
