; Engine configuration file.
; Renderer is pinned to "gl_compatibility" on purpose: tier 2 of this project
; must run on integrated graphics from ~2015. check_renderer.py fails if this
; line changes or if a 3D node appears under game/ or demos/.
; The 3D examples live in game3d/ (ADR 0018). Jolt is named explicitly: the
; setting's DEFAULT still means GodotPhysics3D, and the 2D kit has no 3D body.

config_version=5

[application]

config/name="game-ai-kit"
config/description="Teaching AI in games, one readable piece at a time."
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://menu/menu.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor]

; One import thread, not the default several (T148). On 4.7.2 a cold
; --import with several crashed 11 runs in 115 (signal 11 reimporting
; the translation tables, or SIGABRT at shutdown), and none in 160 with one.
; A similar crash is reported upstream, godotengine/godot#125245;
; docs/godot/cold-import.md.
import/use_multiple_threads=false

[internationalization]

locale/translations=PackedStringArray("res://locale/botmatch.pt_BR.translation", "res://locale/checkers.pt_BR.translation", "res://locale/demo_behaviour.pt_BR.translation", "res://locale/demo_flocking.pt_BR.translation", "res://locale/demo_racing.pt_BR.translation", "res://locale/demo_search.pt_BR.translation", "res://locale/demo_steering.pt_BR.translation", "res://locale/fighting.pt_BR.translation", "res://locale/game_shared.pt_BR.translation", "res://locale/infiltration.pt_BR.translation", "res://locale/maze.pt_BR.translation", "res://locale/menu.pt_BR.translation", "res://locale/racing3d.pt_BR.translation", "res://locale/rts.pt_BR.translation", "res://locale/skirmish.pt_BR.translation", "res://locale/squad.pt_BR.translation", "res://locale/stealth.pt_BR.translation", "res://locale/tactical.pt_BR.translation", "res://locale/talk.pt_BR.translation", "res://locale/tictactoe.pt_BR.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")
