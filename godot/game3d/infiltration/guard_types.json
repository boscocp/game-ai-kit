    "footstep": {"sense": "sound", "priority": 1, "radius": 6.0, "lifetime": 4.0},
    "sprint": {"sense": "sound", "priority": 1, "radius": 12.0, "lifetime": 4.0},
    "thrown_object": {"sense": "sound", "priority": 2, "radius": 10.0, "lifetime": 8.0},
