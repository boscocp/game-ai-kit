{
  "name": "the tactical game's feature conventions",
  "why": "The four numbers the tactical game needs beside its weights, refused by TacticalWeights in the game and by gameaikit.tactical.report in Python with the same code, and for W6 naming the same convention.",
  "cases": [
    {
      "why": "What gameaikit.tactical.report publishes.",
      "conventions": {
        "nearby_radius": 2,
        "reinforcement_distance_when_alone": 15,
        "cheapest_ground": 1,
        "dearest_ground": 3
      },
      "loads": true
    },
    {
      "why": "Whole numbers written with a point: the game's JSON reader cannot tell 2.0 from 2, so neither side refuses it.",
      "conventions": {
        "nearby_radius": 2.0,
        "reinforcement_distance_when_alone": 15,
        "cheapest_ground": 1,
        "dearest_ground": 3.0
      },
      "loads": true
    },
    {
      "why": "No block at all: the game would fall back on numbers of its own.",
      "conventions": null,
      "refused": "W6"
    },
    {
      "why": "A block that is a list.",
      "conventions": [
        2,
        15,
        1,
        3
      ],
      "refused": "W6"
    },
    {
      "why": "A radius of zero counts nobody, and is what a missing key reads as after `get(name, 0)`.",
      "conventions": {
        "nearby_radius": 0,
        "reinforcement_distance_when_alone": 15,
        "cheapest_ground": 1,
        "dearest_ground": 3
      },
      "refused": "W6",
      "about": "nearby_radius"
    },
    {
      "why": "A negative radius.",
      "conventions": {
        "nearby_radius": -1,
        "reinforcement_distance_when_alone": 15,
        "cheapest_ground": 1,
        "dearest_ground": 3
      },
      "refused": "W6",
      "about": "nearby_radius"
    },
    {
      "why": "A radius of 2.5 counts the friends 2 does, and says it counts more.",
      "conventions": {
        "nearby_radius": 2.5,
        "reinforcement_distance_when_alone": 15,
        "cheapest_ground": 1,
        "dearest_ground": 3
      },
      "refused": "W6",
      "about": "nearby_radius"
    },
    {
      "why": "A radius that is a word.",
      "conventions": {
        "nearby_radius": "two",
        "reinforcement_distance_when_alone": 15,
        "cheapest_ground": 1,
        "dearest_ground": 3
      },
      "refused": "W6",
      "about": "nearby_radius"
    },
    {
      "why": "A radius that is `true`.",
      "conventions": {
        "nearby_radius": true,
        "reinforcement_distance_when_alone": 15,
        "cheapest_ground": 1,
        "dearest_ground": 3
      },
      "refused": "W6",
      "about": "nearby_radius"
    },
    {
      "why": "A sentinel too big for a float: infinity to the game, and no whole number to either side.",
      "conventions": {
        "nearby_radius": 2,
        "reinforcement_distance_when_alone": ,
        "cheapest_ground": 1,
        "dearest_ground": 3
      },
      "refused": "W6",
      "about": "reinforcement_distance_when_alone"
    },
    {
      "why": "The dearest ground missing.",
      "conventions": {
        "nearby_radius": 2,
        "reinforcement_distance_when_alone": 15,
        "cheapest_ground": 1
      },
      "refused": "W6",
      "about": "dearest_ground"
    },
    {
      "why": "Two wrong at once: both sides walk the conventions in the order they are declared, so the radius is named first.",
      "conventions": {
        "nearby_radius": "two",
        "reinforcement_distance_when_alone": 15,
        "cheapest_ground": 1
      },
      "refused": "W6",
      "about": "nearby_radius"
    },
    {
      "why": "Each number sound and the pair nonsense: a clamp whose minimum is above its maximum.",
      "conventions": {
        "nearby_radius": 2,
        "reinforcement_distance_when_alone": 15,
        "cheapest_ground": 3,
        "dearest_ground": 1
      },
      "refused": "W7"
    }
  ]
}
