{
  "name": "what every model file must be",
  "why": "The format ai_learning's ModelFile reads and gameaikit.training.model_file writes, held to one answer per file in both languages: the code of the first rule it breaks, or the models it publishes and the fields beside them.",
  "cases": [
    {
      "why": "The smallest file there is: one model and nothing else. No game's fields, and nothing asks for any.",
      "file": {
        "models": {
          "chance": {
            "kind": "logistic",
            "features": [
              "my_health",
              "their_health"
            ],
            "weights": [
              0.05,
              -0.05
            ],
            "bias": 0.5
          }
        }
      },
      "loads": [
        "chance"
      ],
      "extra": []
    },
    {
      "why": "Fields beside `models` are the publishing game's. They are handed over unread, and a file is not refused for carrying them.",
      "file": {
        "generated_by": "somebody's trainer",
        "my_radius": 3,
        "models": {
          "b": {
            "kind": "linear",
            "features": [
              "one"
            ],
            "weights": [
              1.0
            ],
            "bias": 0.0
          },
          "a": {
            "kind": "logistic",
            "features": [
              "one"
            ],
            "weights": [
              1.0
            ],
            "bias": 0.0
          }
        }
      },
      "loads": [
        "a",
        "b"
      ],
      "extra": [
        "generated_by",
        "my_radius"
      ]
    },
    {
