    {
      "why": "A bias JSON cannot spell but can still carry: 1e400 parses to infinity, which multiplies every feature into one answer.",
      "text": "{\"models\": {\"only\": {\"kind\": \"linear\", \"features\": [\"one\"], \"weights\": [1.0], \"bias\": 1e400}}}\n",
      "refused": "M8"
    },
    {
      "why": "`NaN` is not JSON, though Python's reader accepts it unless told not to: both languages refuse the text, not the number.",
      "text": "{\"models\": {\"only\": {\"kind\": \"linear\", \"features\": [\"one\"], \"weights\": [NaN], \"bias\": 0.0}}}\n",
      "refused": "M2"
    },
    {
      "why": "Nor is `Infinity`, for the same reason.",
      "text": "{\"models\": {\"only\": {\"kind\": \"linear\", \"features\": [\"one\"], \"weights\": [1.0], \"bias\": -Infinity}}}\n",
      "refused": "M2"
    },
    {
      "why": "An integer too big for a float, with no exponent: the game reads infinity, and Python must not crash converting it.",
      "text": "{\"models\": {\"only\": {\"kind\": \"linear\", \"features\": [\"one\"], \"weights\": [], \"bias\": 0.0}}}\n",
      "refused": "M8"
    },
