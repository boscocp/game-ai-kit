            4
          ],
          "edge": [
            0,
            0,
            1,
            2
          ],
          "mid": [
            3,
            4,
            6,
            7
          ],
          "far": [
            8,
            9,
            10,
            10
          ]
        }
      }
    ],
    "outputs": [
      {
        "name": "answer",
        "minimum": 0,
        "maximum": 10,
        "samples": 3,
        "sets": {
          "yes": [
            0,
            5,
            10
          ]
        }
      }
    ],
    "rules": [
